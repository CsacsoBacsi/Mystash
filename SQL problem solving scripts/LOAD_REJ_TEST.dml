" ------------------------------------------------------------------------------
" Program: LOAD_REJ_TEST
" Params: LoadID, CubeName, CheckMeas, StopAfter
"         LoadID    => valid, existing XML_LOADID from the XML_LOAD_LOG table
"         CubeName  => valid cube name
"         CheckMeas => boolean to indicate whether to test fact/measure values too
"         StopAfter => positive integer to stop after a given number of errors or zero to indicate that all errors need reporting
" Example: shw load_rej_test (1038, 'PNRG_E_BB1_PN', true, 50)
" Created by: Csaba Riedlinger
" Date: 20th of Jan, 2011
" Purpose: To give detailed messages about rejected rows. A row can be rejected for 3 reasons:
"          1. Any key value is invalid (not a member in the dimensions)
"          2. Any key value is of wrong level (valid member of the dimension but addresses the wrong level in the hierarchy)
"          3. Invalid fact value (e.g. numeric expected but text given)
"          The program reads the relational mappings and generates another DML (DO_LOAD_REJ_TEST) to emulate what the built in Oracle
"          loader does and more as any rejected row gets registered.
"          Relational tables in the CLIENT_APPS schema are maintained to hold the individual error messages generated
" Returns: 0  - no error
"          -1 - error occurred
" Modified by/on: CR - 20/01/2011 - Initial version
"----------------------------------------------------------------------------------------------------------------------------------------------

" Arguments
arg _loadid integer   " XML Load Log ID
arg _cube text        " Cube name
arg _chk_meas boolean " If set to 'Y' or true, measure values are also checked if correct otherwise dimkeys are checked only
arg _stop integer     " Stop after this number of errors

" Local variables
vrb _dims text         " All dimensions in the level map
vrb _thisdim text      " A particular dimension
vrb _surdims text      " Surrogate dim values
vrb _surmeas text      " Surrogate measures
vrb _lvl  text         " Single level
vrb _surrlvl text      " Surrogate level
vrb _lvls text         " All the levels in the level map
vrb _col  text         " Single column
vrb _cols text         " All columns in the SQL select
vrb _meas text         " Single measure
vrb _meass text        " All measures in the measure map
vrb _mcol text         " Measure column
vrb _mcols text        " Measure columns in he measure map
vrb _schemavw text     " Schema dot table/view name
vrb _sql      text     " The SQL select
vrb _na       text     " NA to mean NULL
vrb _prg text          " Holds the program lines of the dynamically generated DML
vrb _prgline text      " A single line of the dynamically generated program (support var)
vrb i integer          " Loop variable
vrb j integer          " Loop variable
vrb date_time datetime " Current date and time (used to identify errors generated by this run)
vrb _retval text       " Return value from dynamic DML (contains number of errrors per error type)
vrb inv_key integer    " Number of invalid key value errors
vrb inv_lvl integer    " Number of invalid level errors
vrb _invlvl text       " Holds a text fragment from the return value
vrb inv_meas integer   " Number of invalid measure errors

trap on error noprint

" Parameter checks
if _cube eq na
then do
    shw 'Invalid argument: first parameter must be a valid cube name!'
    return -1
doend
if _chk_meas eq na
then do
    shw 'Invalid argument: second parameter must be a boolean (true/false) value!'
    return -1
doend
if _stop lt 0 or _stop eq na
then do
    shw 'Invalid argument: third parameter must be a positive integer value or a zero to indicate all errors need reporting!'
    return -1
doend

" Get timestamp
date_time = to_date (joinchars (to_char (sysdate, 'DD/MM/YYYY'), ' ' tod), 'DD/MM/YYYY HH24:MI:SS')

" Get dimension member - level - SQL column mapping
lmt mapgroup_dim to extchars (mapgroup_dim, 1, findchars (mapgroup_dim, '.') -1) eq _cube

if statlen (mapgroup_dim) eq 0
then do
    shw joinchars ('No key mapping found for cube ' _cube '!')
    return -1
doend

i = 1
for LVL_MAP_COMPOSITE
do

    _dims = joinlines (_dims, extchars (all_levels, 1, findchars (all_levels, '.') - 1))
    _surdims = joinlines (_surdims, joinchars ('_Dim' i))
    _lvl =  extchars (all_levels, findchars (all_levels, '.') + 1)
    _lvl =  extchars (_lvl, 1, findchars (_lvl, '.') - 1)
    _lvls = joinlines (_lvls, _lvl)
    _col =  extchars (meas_key_map, findchars (meas_key_map, '.') + 1)
    _col =  extchars (_col, findchars (_col, '.') + 1)
    _cols = joinlines (_cols, _col)
    _schemavw = extchars (meas_key_map, 1, findchars (meas_key_map, joinchars ('.' _col))- 1)
    i = i + 1

doend

" Get measure - SQL column mapping
lmt all_measures to extchars (all_measures, 1, findchars (all_measures, '.') -1) eq _cube

if statlen (all_measures) eq 0 and _chk_meas
then do
    shw joinchars ('No measure mapping found for cube ' _cube '!')
    return -1
doend

i = 1
for meas_map_composite
do

    _meas =  extchars (all_measures, findchars (all_measures, '.') + 1)
    _meas =  extchars (_meas, 1, findchars (_meas, '.') - 1)
    _meass = inslines (_meass, _meas)
    _surmeas = joinlines (_surmeas, joinchars ('_Meas' i))
    _mcol =  extchars (meas_data_map, findchars (meas_data_map, '.') + 1)
    _mcol =  extchars (_mcol, findchars (_mcol, '.') + 1)
    _mcols = inslines (_mcols, _mcol)
    i = i + 1

doend

" Create another DML dynamically
" Arguments
_prg = joinchars ('" Author: Csaba Riedlinger, generated by LOAD_REJ_TEST at ' to_char (to_date (joinchars (to_char (sysdate, 'DD/MM/YYYY'), ' ' tod), 'DD/MM/YYYY HH24:MI:SS') 'DD/MM/YYYY HH24:MI:SS'))
_prg = joinlines (_prg, 'arg _loadid integer')
_prg = joinlines (_prg, 'arg _datetime datetime')
_prg = joinlines (_prg, 'arg _stopafter integer')
_prg = joinlines (_prg, '')
_prg = joinlines (_prg '" Local variables')

" Variable declaration section
i = 1

while i le numlines (_dims)
do
    _prg = joinlines (_prg, joinchars ('vrb ' extlines (_surdims, i, 1) ' text'))
    i = i + 1
doend
i = 1
while i le numlines (_meass)
do
    _prg = joinlines (_prg, joinchars ('vrb ' extlines (_surmeas, i, 1) ' decimal'))
    i = i + 1
doend

_prg = joinlines (_prg, 'vrb _errmsg text')
_prg = joinlines (_prg, 'vrb _errtype text')

_prg = joinlines (_prg, 'vrb _inv_key integer')
_prg = joinlines (_prg, 'vrb _inv_lvl integer')
_prg = joinlines (_prg, 'vrb _inv_meas integer')
_prg = joinlines (_prg, 'vrb _all_errs integer')

" Initialization
_prg = joinlines (_prg, '')
_prg = joinlines (_prg, 'trap on error noprint')
_prg = joinlines (_prg, 'errortext = \'\'')
_prg = joinlines (_prg, 'SQL PREPARE s1 FROM INSERT INTO CLIENT_APPS.XML_LOAD_ERR_DETAIL VALUES (:_loadid, :_errtype, :_errmsg)')
_prg = joinlines (_prg, '_inv_key = 0')
_prg = joinlines (_prg, '_inv_lvl = 0')
_prg = joinlines (_prg, '_inv_meas = 0')
_prg = joinlines (_prg, '_all_errs = 0')
_prg = joinlines (_prg, '')

_prg = joinlines (_prg 'if _stopafter eq 0')
_prg = joinlines (_prg 'then do')
_prg = joinlines (_prg '    _stopafter = 2147483647') " Max value = 2 ** 31 - 1
_prg = joinlines (_prg 'doend')
_prg = joinlines (_prg, '')


" Level limits
i = 1
_prg = joinlines (_prg '" Level limits')
while i le numlines (_lvls)
do
    _thisdim = extlines (_dims, i, 1)
    lmt all_dimensions to joinchars (_thisdim '.DIMENSION')
    if dimkey_is_unique
    then do
        _prg = joinlines (_prg, joinchars ('lmt ' extlines (_dims, i, 1) ' to ' extlines (_dims, i, 1)  '_levelrel eq \'' extlines (_lvls, i, 1)'\''))
    doend
    else do
        _prg = joinlines (_prg, joinchars ('lmt ' extlines (_dims, i, 1) '_' extlines (_lvls, i, 1) '_SURR to ' extlines (_dims, i, 1)  '_levelrel eq \'' extlines (_lvls, i, 1)'\''))
    doend
    i = i + 1
doend
_prg = joinlines (_prg, '')

" SQL select
_prgline = 'sql declare c1 cursor for select '
 i = 1

while i le numlines (_cols)
do
    _prgline = joinchars (_prgline, extlines (_cols, i, 1) ', ')
    i = i + 1
doend
i = 1
while i le numlines (_mcols)
do
    _prgline = joinchars (_prgline, extlines (_mcols, i, 1) ', ')
    i = i + 1
doend

_prgline = extchars (_prgline, 1, numchars (_prgline) - 2)
_prgline = joinchars (_prgline ' from ' _schemavw)
_sql = extchars (_prgline, 27)
_prg = joinlines (_prg _prgline)
_prg = joinlines (_prg 'sql open c1')
_prg = joinlines (_prg 'if sqlcode ne 0')
_prg = joinlines (_prg 'then goto error')
_prg = joinlines (_prg, '')
_prg = joinlines (_prg 'while sqlcode eq 0')
_prg = joinlines (_prg 'do')

" SQL fetch
_prgline = '    sql fetch c1 into '
 i = 1
while i le numlines (_dims)
do
    _prgline = joinchars (_prgline, ':' extlines (_surdims, i, 1) ', ')
    i = i + 1
doend
i = 1
while i le numlines (_meass)
do
    _prgline = joinchars (_prgline, ':' extlines (_surmeas, i, 1) ', ')
    i = i + 1
doend

_prgline = extchars (_prgline, 1, numchars (_prgline) - 2)
_prg = joinlines (_prg _prgline)
_prg = joinlines (_prg, '')

" Exit if predefined number of errors exceeded or query returned all rows
_prg = joinlines (_prg '    if _all_errs gt _stopafter')
_prg = joinlines (_prg '    then do')
_prg = joinlines (_prg '        sql close c1')
_prg = joinlines (_prg '        shw joinchars (\'Maximum allowed number of errors exceeded.\')')
_prg = joinlines (_prg '        return joinchars (_inv_key\'#\' _inv_lvl\'*\' _inv_meas)')
_prg = joinlines (_prg '    doend')
_prg = joinlines (_prg, '')

_prg = joinlines (_prg '    if sqlcode ne 0')
_prg = joinlines (_prg '    then do')
_prg = joinlines (_prg '        sql close c1')
_prg = joinlines (_prg '        return joinchars (_inv_key\'#\' _inv_lvl\'*\' _inv_meas)')
_prg = joinlines (_prg '    doend')
_prg = joinlines (_prg, '')

" Dimension member existence test + hier level test
i = 1
while i le numlines (_dims)
do
    _prgline = joinchars ('    " ' extlines (_dims, i, 1) ' dimension')
    _prg = joinlines (_prg _prgline)

    _thisdim = extlines (_dims, i, 1)
    lmt all_dimensions to joinchars (_thisdim '.DIMENSION')
    if dimkey_is_unique
    then do
        _prg = joinlines (_prg joinchars ('    if not isvalue (' extlines (_dims, i, 1) ' ' extlines (_surdims, i, 1) ')'))
        _prg = joinlines (_prg '    then do')
        _prgline = joinchars ('        _errmsg = joinchars (\'' extlines (_dims, i, 1) ' dim member error. \' ' extlines (_surdims, i, 1) ' \' does not exist!\')')
    doend
    else do
        _prg = joinlines (_prg joinchars ('    if not isvalue (' extlines (_dims, i, 1), '_' extlines (_lvls, i, 1) '_SURR' ' ' extlines (_surdims, i, 1) ')'))
        _prg = joinlines (_prg '    then do')
        _prgline = joinchars ('        _errmsg = joinchars (\'' extlines (_dims, i, 1) '_' extlines (_lvls, i, 1) '_SURR' ' dim member error. \' ' extlines (_surdims, i, 1) ' \' does not exist!\')')
    doend
    _prg = joinlines (_prg _prgline)
    _prg = joinlines (_prg '        _errtype = \'INV_KEY\'')
    _prg = joinlines (_prg '        _inv_key = _inv_key + 1')
    _prg = joinlines (_prg '        _all_errs = _all_errs + 1')
    _prg = joinlines (_prg '        SQL EXECUTE s1')
    _prg = joinlines (_prg '        commit')
    _prg = joinlines (_prg '        continue')
    _prg = joinlines (_prg '    doend')

    if dimkey_is_unique
    then do
        _prg = joinlines (_prg joinchars ('    if not instat (' extlines (_dims, i, 1) ' ' extlines (_surdims, i, 1) ')'))
        _prg = joinlines (_prg '    then do')
        _prgline = joinchars ('        _errmsg = joinchars (\'' extlines (_dims, i, 1) ' dim member level error. \' ' extlines (_surdims, i, 1) ' \' belongs to another level of the dim hierarchy!\')')
    doend
    else do
        _prg = joinlines (_prg joinchars ('    if not instat (' extlines (_dims, i, 1) , '_' extlines (_lvls, i, 1) '_SURR' ' ' extlines (_surdims, i, 1) ')'))
        _prg = joinlines (_prg '    then do')
        _prgline = joinchars ('        _errmsg = joinchars (\'' extlines (_dims, i, 1)'_' extlines (_lvls, i, 1) '_SURR' ' dim member level error. \' ' extlines (_surdims, i, 1) ' \' belongs to another level of the dim hierarchy!\')')
    doend
    _prg = joinlines (_prg _prgline)
    _prg = joinlines (_prg '        _errtype = \'INV_LVL\'')
    _prg = joinlines (_prg '        _inv_lvl = _inv_lvl + 1')
    _prg = joinlines (_prg '        _all_errs = _all_errs + 1')
    _prg = joinlines (_prg '        SQL EXECUTE s1')
    _prg = joinlines (_prg '        commit')
    _prg = joinlines (_prg '        continue')
    _prg = joinlines (_prg '    doend')

    _prg = joinlines (_prg, '')
    i = i + 1
doend

" Measure (fact) check
if _chk_meas
then do

    _prg = joinlines (_prg '    " Measures')
    i = 1
    while i le numlines (_dims)
    do
        _prgline = joinchars ('    lmt ' extlines (_dims, i, 1) ' to ' extlines (_surdims, i, 1))
        _prg = joinlines (_prg _prgline)
        i = i + 1
    doend
    _prg = joinlines (_prg, '')

    i = 1
    while i le numlines (_meass)
    do
        _prgline = joinchars ('    trap on ' extlines (_surmeas, i, 1) 'err noprint')
        _prg = joinlines (_prg _prgline)

        if is.compressed (_cube)
        then do
            _prg = joinlines (_prg joinchars ('    ' _cube '_PRT_TOPVAR (' _cube '_PRT_MEASDIM \'' extlines (_meass, i, 1) '\') = ' extlines (_surmeas, i, 1)))
        doend
        else do
            _prg = joinlines (_prg joinchars ('    ' _cube '_' extlines (_meass, i, 1) '_STORED = ' extlines (_surmeas, i, 1)))
        doend
        i = i + 1
    doend

    _prg = joinlines (_prg, '')
    _prg = joinlines (_prg '    goto MeasOK')
    _prg = joinlines (_prg, '')

    " Error labels
    i = 1
    while i le numlines (_meass)
    do

        _prg = joinlines (_prg joinchars ('    ' extlines (_surmeas, i, 1) 'err:'))
        j = 1
        _prgline = joinchars ('    _errmsg = joinchars (\'Invalid value for measure ' extlines (_meass, i, 1) '. \' ')
        while j le numlines (_dims)
        do
            _prgline = joinchars (_prgline '\'' extlines (_dims, j, 1) ': \' ' extlines (_surdims, j, 1) ' \', \' ')
            j = j + 1
        doend
        j = 1
        while j le numlines (_meass)
        do
            _prgline = joinchars (_prgline '\'' extlines (_meass, j, 1) ': \' ' extlines (_surmeas, j, 1) ' \', \' ')
            j = j + 1
        doend

        _prgline = extchars (_prgline, 1, numchars (_prgline) - 5)
        _prg = joinlines (_prg joinchars (_prgline ')'))
        _prg = joinlines (_prg '    _errtype = \'INV_MEAS\'')
        _prg = joinlines (_prg '    _inv_meas = _inv_meas + 1')
        _prg = joinlines (_prg '    _all_errs = _all_errs + 1')
        _prg = joinlines (_prg '    SQL EXECUTE s1')
        _prg = joinlines (_prg '    commit')
        _prg = joinlines (_prg '    continue')
        i = i + 1

    doend

    _prg = joinlines (_prg, '')
    _prg = joinlines (_prg '    MeasOK:')
    _prg = joinlines (_prg '    trap on error noprint')
    _prg = joinlines (_prg, '')
doend

_prg = joinlines (_prg 'doend')
_prg = joinlines (_prg, '')
_prg = joinlines (_prg 'sql close c1')
_prg = joinlines (_prg, '')

" Return value (statistics)
_prg = joinlines (_prg 'return joinchars (_inv_key\'#\' _inv_lvl\'*\' _inv_meas)')
_prg = joinlines (_prg, '')

" Error handling
_prg = joinlines (_prg 'error:')
_prg = joinlines (_prg 'shw errortext')
_prg = joinlines (_prg 'shw sqlerrm')
_prg = joinlines (_prg 'return joinchars (errortext \' \' sqlerrm)')

" Define program, compile and execute
if not exists ('DO_LOAD_REJ_TEST')
then do
    dfn do_load_rej_test program text
doend
cns do_load_rej_test
program _prg
cmp do_load_rej_test

" Insert into header table
SQL PREPARE s1 FROM INSERT INTO CLIENT_APPS.XML_LOAD_ERR_HEADER VALUES (:_loadid, :_cube, :date_time, :_sql, :inv_key, :inv_lvl, :inv_meas, :_na, :_na)
SQL EXECUTE s1 " Execute prepared statement (INSERT)

if sqlcode ne 0 " Check if any error occurred
then do
    shw joinchars ('Could not create header row due to an SQL error: ' sqlcode ': ' sqlerrm)
    return -1
doend

COMMIT

" Execute dynamically generated DML
_retval = do_load_rej_test (_loadid, date_time, _stop)

" Process return value
if findchars (_retval '#') gt 0 and findchars (_retval '*') gt 0
then do
    inv_key = convert (extchars (_retval, 1, findchars (_retval '#') - 1) integer)
    _invlvl = extchars (_retval, findchars (_retval '#') + 1)
    inv_lvl = convert (extchars (_invlvl, 1, findchars (_invlvl '*') - 1)  integer)
    inv_meas = convert (extchars (_retval, findchars (_retval '*') + 1) integer)

    " Update header table with statistics
    SQL PREPARE s2 FROM UPDATE CLIENT_APPS.XML_LOAD_ERR_HEADER SET INV_KEY=:inv_key, INV_LVL=:inv_lvl, INV_MEAS=:inv_meas, STATUS='OK', MESSAGE='Success' WHERE XML_LOADID = :_loadid
    SQL EXECUTE s2
doend
else do
    " Update header table with statistics
    SQL PREPARE s3 FROM UPDATE CLIENT_APPS.XML_LOAD_ERR_HEADER SET STATUS='ERROR', MESSAGE=:_retval WHERE XML_LOADID = :_loadid
    SQL EXECUTE s3
doend

if sqlcode ne 0 " Check if any error occurred
then do
    shw joinchars ('Could not update header row due to an SQL error: ' sqlcode ': ' sqlerrm)
    return -1
doend

if findchars (_retval '#') gt 0 and findchars (_retval '*') gt 0
then do
    COMMIT
    return 0
doend
else do
    return -1
doend

" Error handling
error:
shw joinchars ('Error: ' errortext)
return -1
