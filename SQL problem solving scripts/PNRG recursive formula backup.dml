DEFINE PNRG_E_BB_RR_SC_VW_RENEWED_VOL FORMULA DECIMAL <PNRG_E_BB_RR_SC ELEC_PRODUCT BUSINESS_STRUCTURE ELEC_METERING_TYPE RENEWAL_MONTH TIME>
EQ -
IF STATRANK (TIME) EQ 1 THEN (PNRG_E_BB_RR_HIDDEN_ORIG_VOL * (PNRG_E_BB_RR_SC_VW_PCT_RENEWAL / 100)) ELSE NAFILL (PNRG_E_BB_RR_SC_VW_RENEWED_VOL_PRG, PNRG_E_BB_RR_HIDDEN_ORIG_VOL * (PNRG_E_BB_RR_SC_VW_PCT_RENEWAL / 100))
