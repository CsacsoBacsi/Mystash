Old:
DEFINE PNRG_E_BB_RR_SC_VW_RENEWED_VOL FORMULA DECIMAL <PNRG_E_BB_RR_SC ELEC_PRODUCT BUSINESS_STRUCTURE ELEC_METERING_TYPE RENEWAL_MONTH TIME>
EQ -
IF STATRANK(TIME) EQ 1 THEN (PNRG_E_BB_RR_HIDDEN_ORIG_VOL * (PNRG_E_BB_RR_SC_VW_PCT_RENEWAL / 100 ) ) ELSE NAFILL(LAG(THIS_AW!PNRG_E_BB_RR_SC_VW_RENEWED_VOL 1 TIME) , PNRG_E_BB_RR_HIDDEN_ORIG_VOL ) * (PNRG_E_BB_RR_SC_VW_PCT_RENEWAL / 100 )

