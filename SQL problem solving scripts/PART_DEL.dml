" ------------------------------------------------------------------------------
" Program: PART_DEL
" Params: CubeName, DimVal
" Return value: 0 if no error occurred, -1 otherwise
" Example: shw part_del ('G_GRAN_CONS_SETT', 0, 'N10015', false)
" Created by: Csaba Riedlinger
" Date: 16th of Nov, 2007
" Purpose: To 'safely' delete a partition/scenario from a cube.
"          The program deletes the following items:
"          1. Dimension value from the partitioning dimension (if parameter 4 is true)
"          2. Partition value from the metadata dimension unless it is partition P0
"          3. Partition from the template and cube
"          4. Partition composite if used any
"          5. Other not used composites that once were associated with the partition
"          For cubes of type 1 and 2, the program deletes:
"          1. Dimension value from the partitioning dimension (if parameter 4 is true)
"          2. Stored variable that accommodates the scenario
"          3. Stored variable's composites (Time-Measure-Change dim composite, the other composite)
" Modified by/on:
" CR - 16-Jul-2008 - Parameter _deldimval added. User can opt not to delete dimension value
" CR - 16-Jul-2008 - Parameter _cubetype added. Code handles custom override cubes

arg _cube        text    " Cube name
arg _cubetype    integer " 0, 1 or 2. 0 = standard cube. 1 or 2 = custom override cube
arg _dimval      text    " A dimension value that the cube is partitioned on
arg _deldimval   boolean " Whether to delete the dimension value from the partitioning dimension or not

vrb _p_cube      text    " Cube's physical, variable name
vrb _partby      text    " Dimension the cube is partitioned by
vrb _part_templ  text    " An individual cube's partition template
vrb _prt_roots   text    " Metadata relation that holds dim value - partition touples
vrb _prt_dim     text    " Metadata dimension that holds all the partitions
vrb _part        text    " Partition identifier that corresponds with the dimval
vrb _dims        text    " List of dims in the partition (not just partitioning dimension!)
vrb _partline    text    " Holds the composite definition in a partition definition
vrb _comp_name   text    " Holds the composite name
vrb _comp_list   text    " List of composites belonging to a cube
vrb _action      text    " List of actions taken (for the record)
vrb _var         text    " Holds the variable name for cubes of type 1 and 2
vrb _tmc_comp    text    " Holds the Time-Measure-Change dim composite name
vrb j            integer " Loop variable

trap on error noprint
badline = yes

blank
shw '*******************************************'
shw 'Scenario/version/partition deletion utility'
shw '*******************************************'

switch _cubetype
do
     case 0:

          " Check if cube is partitioned
          if not exists (joinchars (_cube '_PARTITION_TEMPLATE'))
          then do
               shw joinchars ('Cube ' _cube ' is not partitioned.')
               errorname = 'NOPART01'
               errortext = joinchars ('Cube ' _cube ' is not partitioned.')
               return -1
          doend

          " Construct objects
          _part_templ = joinchars (_cube '_PARTITION_TEMPLATE')
          _prt_roots = joinchars (_cube '_PRT_ROOTS')
          _prt_dim = joinchars (_cube '_PRT_DIM')
          _partby = obj (partby _part_templ)
          if not isvalue (&_partby _dimval)
          then do
               shw joinchars ('Value passed as parameter is not a valid member in dimension ' _partby '.')
               errorname = 'INVDIMVAL01'
               errortext = joinchars ('Value passed as parameter is not a valid member in dimension ' _partby '.')
               return -1
          doend

          " Get partition and dim value assigned to it
          lmt &_partby to _dimval
          _part = partition (&_part_templ)
          if _part eq na
          then do
               shw joinchars ('Partition corresponding to dimension value ' _dimval ' could not be found.')
               errorname = 'INVPART01'
               errortext = joinchars ('Partition corresponding to dimension value ' _dimval ' could not be found.')
               return -1
          doend
          " Partition P0 is taboo
          if _part eq 'P0'
          then do
               shw 'Partition P0 can not be dropped.'
               errorname = 'PARTP0'
               errortext = 'Partition P0 can not be dropped.'
               return -1
          doend

          _dims = obj (partdims _part _part_templ)
          _partline = extlines (_dims findchars(_dims '<'  1 linenum) 1)
          _comp_name = extchars (_partline 1 findchars (_partline '<') -2)

          " Display 'participating' objects
          blank
          row under '-' 'Parameters:'
          shw joinchars ('Cube               : ' _cube)
          shw joinchars ('Dimension value    : ' _dimval)
          shw joinchars ('Partition template : ' _part_templ)
          shw joinchars ('Metadata relation  : ' _prt_roots)
          shw joinchars ('Metadata part dim  : ' _prt_dim)
          shw joinchars ('Partitioning dim   : ' _partby)
          shw joinchars ('Partition          : ' _part)
          shw joinchars ('Partition composite: ' _comp_name)

          " Delete partition from metadata dimension
          if exists (_prt_dim)
          then do
               &(joinchars ('MNT ' _prt_dim ' DELETE \'' _part '\''))
               _action = joinchars ('->MNT ' _prt_dim ' DELETE \'' _part '\'')
               _action = joinlines (_action joinchars ('Partition value ' _part ' deleted from the partitioning metadata dimension.'))
          doend
          " Delete partition from template, dissociate instance from cube
          &(joinchars ('CHGDFN ' _part_templ ' DELETE CLEAR (PARTITION ' _part ')'))
          _action = joinlines (_action joinchars ('->CHGDFN ' _part_templ ' DELETE CLEAR (PARTITION ' _part ')'))
          _action = joinlines (_action joinchars ('Partition ' _part ' dropped from template ' _part_templ ' and de-instantiated from cube.'))
          if _deldimval
          then do
               " Delete value from dimension
               &(joinchars ('MNT ' _partby ' DELETE \'' _dimval '\''))
               _action = joinlines (_action joinchars ('->MNT ' _partby ' DELETE \'' _dimval '\''))
               _action = joinlines (_action joinchars ('Dimension value ' _dimval ' deleted from dimension ' _partby '.'))
          doend
          else do
               _action = joinlines (_action joinchars ('Dimension value ' _dimval ' has NOT been deleted from dimension ' _partby ' on user request.'))
          doend

          " Assumes that it is a global composite then. Probably later version will deal with it...
          if findchars (_cube 'SC_N_NC') eq 0
          then do
               if nafill (cube_catalog (all_cubes joinchars(_cube '.CUBE'), cube_prop 'COMP_COMPRESSED'), 'NO') eq 'NO'
               then do
                    _action = joinlines (_action 'Cube is not compressed therefore can not drop composite(s).')
               doend
               else do
                    " Delete composite used by partition
                    dlt &_comp_name
                    _action = joinlines (_action joinchars ('->DELETE ' _comp_name))
                    _action = joinlines (_action joinchars ('Partition composite ' _comp_name ' deleted from partition ' _part '.'))
                    if _comp_name like joinchars (_cube '_' _dimval '_PRTCOMP%')
                    then do
                         _comp_list = limit (name to obj (property 'AW$PARENT_NAME') eq _cube and obj (type name) eq 'COMPOSITE' and findchars (name joinchars (_cube '_' _dimval '_PRTCOMP')) gt 0)
                    doend
                    else do
                         _action = joinlines (_action joinchars ('Composite ' _comp_name ' does not follow usual naming convention. Unused composites not safe to be dropped.'))
                    doend

                    " Delete composite(s) once associated with this partition
                    j = 1
                    while j le numlines (_comp_list)
                    do
                         trap on delerror noprint
                         &(joinchars ('dlt ' extlines (_comp_list j 1)))
                         _action = joinlines (_action joinchars ('->DELETE ' extlines (_comp_list j 1)))
                         _action = joinlines (_action joinchars ('Unused composite ' extlines (_comp_list j 1) ' deleted.'))
                         goto noerror
                         delerror:
                         trap on error noprint " If a composite is being used by another object, it can not be dropped/deleted
                         _action = joinlines (_action joinchars ('->DELETE ' extlines (_comp_list j 1) ' - Failed'))
                         _action = joinlines (_action joinchars ('Could not delete (seemingly unused) composite ' extlines (_comp_list j 1) '. It may be in use...'))
                         noerror:
                         j = j + 1
                    doend
               doend
          doend
          else do
               " Delete composite used by partition
               dlt &_comp_name
               _action = joinlines (_action joinchars ('->DELETE ' _comp_name))
               _action = joinlines (_action joinchars ('Partition composite ' _comp_name ' deleted from partition ' _part '.'))
          doend

          break

     case 1: " Cubes of type 1 and 2 must be treated differently as each scenario is stored in separate stored variables
     case 2:

          _var = joinchars (_cube '_PRT_TOPVAR_' _dimval)
          if findchars (_cube 'SC_N_NC') gt 0
          then do
               _comp_name = joinchars (_cube '_COMP_' _dimval)
               _tmc_comp  = joinchars (_cube '_TMCCOMP_' _dimval)
          doend
          else do
               _comp_name = joinchars (_cube '_' _dimval '_PRTCOMP')
          doend

          if not exists (_var)
          then do
               errorname = 'PARTDEL01'
               errortext = 'ERROR: Stored variable for specified scenario value does not exist'
               return -1
          doend

          " Display 'participating' objects
          blank
          row under '-' 'Parameters:'
          shw joinchars ('Cube               : ' _cube)
          shw joinchars ('Dimension value    : ' _dimval)
          if findchars (_cube 'SC_N_NC') gt 0
          then shw joinchars ('TMC composite      : ' _tmc_comp)
          shw joinchars ('Partition composite: ' _comp_name)

          &(joinchars ('dlt ' _var))
          _action = joinchars ('->DELETE ' _var)
          _action = joinlines (_action joinchars ('Stored variable representing scenario ' _dimval ' has been deleted.'))
          if findchars (_cube 'SC_N_NC') gt 0
          then do
              &(joinchars ('dlt ' _tmc_comp))
              _action = joinlines (_action, joinchars ('->DELETE ' _tmc_comp))
              _action = joinlines (_action joinchars ('Time-Measure_change dim composite ' _tmc_comp ' has been deleted.'))
          doend
          &(joinchars ('dlt ' _comp_name))
          _action = joinlines (_action joinchars ('->DELETE ' _comp_name))
          _action = joinlines (_action joinchars ('Local composite ' _comp_name ' has been deleted.'))

          if _deldimval
          then do
               if findchars (_cube 'SC_N') gt 0
               then _partby = joinchars (extchars (_cube, 1, findchars (_cube 'SC_N') -2) '_SC')
               else _partby = joinchars (extchars (_cube, 1, findchars (_cube 'SC_N') -2) '_VER')
               " Delete value from dimension
               &(joinchars ('MNT ' _partby ' DELETE \'' _dimval '\''))
               _action = joinlines (_action joinchars ('->MNT ' _partby ' DELETE \'' _dimval '\''))
               _action = joinlines (_action joinchars ('Dimension value ' _dimval ' deleted from dimension ' _partby '.'))
          doend
          else do
               _action = joinlines (_action joinchars ('Dimension value ' _dimval ' has NOT been deleted from dimension ' _partby ' on user request.'))
          doend

          break
doend

" For the record, which actions have been taken
blank
"shw '***** Actions taken *****'
j = 1
while j le numlines (_action)
do
    shw extlines (_action j 1)
    j = j + 1
doend
"shw '***** End of report *****'
blank
shw 'AW has not been updated/committed.'

return 0

error:
_action = joinlines (_action errortext)
blank
"shw '********** Actions taken **********'
j = 1
while j le numlines (_action)
do
    shw extlines (_action j 1)
    j = j + 1
doend

return -1