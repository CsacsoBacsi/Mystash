from pyspark.sql.functions import udf
from pyspark.sql.types import IntegerType

# Define a UDF
def multiply_by_two(x):
    return x * 2

multiply_udf = udf(multiply_by_two, IntegerType())

# Apply UDF
df.withColumn("new_column", multiply_udf(df["column"])).show()

